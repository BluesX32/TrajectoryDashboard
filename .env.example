# .env.example — TrajectoryDashboard OMOP CDM connection settings
# Copy to .env and fill in your site's values.
# Never commit the .env file (it is gitignored by default).

# ---- Platform (choose one) -----------------------------------------------
# SQL_DBMS=sql server      # default; also: postgresql, spark, redshift

# ---- SQL Server + Windows AD (Johns Hopkins) ------------------------------
SQL_SERVER=yourserver.institution.edu
SQL_DATABASE=OMOP_CDM
SQL_CDM_SCHEMA=dbo
# SQL_VOCABULARY_SCHEMA=dbo      # defaults to CDM schema
USE_WINDOWS_AUTH=true
SQL_JDBC_PATH=jdbc_drivers/sql

# ---- SQL Server + username/password (alternative) --------------------------
# SQL_SERVER=yourserver.institution.edu
# SQL_DATABASE=OMOP_CDM
# SQL_CDM_SCHEMA=dbo
# SQL_USER=your_username
# SQL_PASSWORD=your_password
# SQL_JDBC_PATH=jdbc_drivers/sql

# ---- PostgreSQL ------------------------------------------------------------
# SQL_DBMS=postgresql
# SQL_SERVER=localhost
# SQL_DATABASE=omop_cdm
# SQL_CDM_SCHEMA=cdm_54
# SQL_USER=omop_user
# SQL_PASSWORD=your_password

# ---- Databricks / Spark (generic) ------------------------------------------
# SQL_DBMS=spark
# SQL_SERVER=your-workspace.cloud.databricks.com
# SQL_DATABASE=default
# SQL_CDM_SCHEMA=omop.data
# SQL_USER=token
# SQL_PASSWORD=your_databricks_token
# DB_EXTRA_SETTINGS=httpPath=/sql/1.0/warehouses/your_warehouse_id
# SQL_JDBC_PATH=jdbc_drivers/databricks

# ---- Databricks via REACH / SAFER Desktop (JHU) ----------------------------
# Use create_safer_connection("R.env") to load this block automatically.
# The function auto-detects proxy vs. no-proxy based on DATABRICKS_USER_PROXY.
#
# Server hostname (from warehouse > Advanced Options > JDBC/ODBC tab)
# DATABRICKS_SERVER_HOSTNAME=adb-1234567890123456.7.azuredatabricks.net
#
# HTTP path (from warehouse > Advanced Options > JDBC/ODBC tab)
# DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/abcdef1234567890
#
# Personal Access Token (Databricks Workspace > User Settings > Developer > Access Tokens)
# DATABRICKS_TOKEN=dapi_xxxxxxxxxxxxxxxxxxxx
#
# Catalogs (Unity Catalog three-tier hierarchy)
# DATABRICKS_DATA_CATALOG=deid          # CDM schema becomes deid.omop
# DATABRICKS_USER_CATALOG=reach_users   # scratch catalog
# DATABRICKS_USERNAME=                  # your JHU username (e.g. mxiong5)
#
# Path to the Databricks JDBC jar
# SAFER Desktop (standard location from REACH-Templates):
# DATABRICKS_JDBC_JAR=C:/jdbc/databricks-jdbc-2.6.36.jar
# Discovery HPC:
# DATABRICKS_JDBC_JAR=~/jdbc/databricks-jdbc-2.6.36.jar
# If omitted or path not found, the driver is auto-downloaded to ~/jdbc/ (Mac/Linux)
# or C:/jdbc/ (Windows).
#
# Proxy — set to 1 on SAFER Desktop; leave commented out on Discovery HPC
# DATABRICKS_USER_PROXY=1
# DATABRICKS_PROXY_HOST=proxy.jh.edu   # default when USER_PROXY=1
# DATABRICKS_PROXY_PORT=3129           # default when USER_PROXY=1
#
# Arrow acceleration (off by default; unstable behind proxies)
# DATABRICKS_ENABLE_ARROW=0
