# =============================================================================
# REACH Databricks Connection Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.template .env
#
# NEVER commit the .env file to version control.
# On Discovery HPC, place at ~/.env with: chmod 600 ~/.env
# =============================================================================

# --- Azure Databricks Workspace ---
# The workspace URL (with https://, no trailing slash)
# Example: https://adb-1234567890123456.7.azuredatabricks.net
DATABRICKS_HOST=

# --- Authentication ---
# Personal Access Token (PAT)
# Generate at: Databricks Workspace > User Settings > Developer > Access Tokens
DATABRICKS_AUTH_TYPE=pat
DATABRICKS_TOKEN=

# --- Cluster (Optional, for Databricks Connect and on-cluster use) ---
# Cluster ID (found in Compute > your cluster > Configuration tab, or from the cluster URL)
# Example: 0123-456789-abcdefgh
DATABRICKS_CLUSTER_ID=

# --- SQL Warehouse / Cluster JDBC (for SQL Connector) ---
# Server hostname (from cluster/warehouse > Advanced Options > JDBC/ODBC tab)
# Example: adb-1234567890123456.7.azuredatabricks.net
DATABRICKS_SERVER_HOSTNAME=

# HTTP Path (from cluster/warehouse > Advanced Options > JDBC/ODBC tab)
# Cluster example:  /sql/protocolv1/o/1234567890123456/0123-456789-abcdefgh
# Warehouse example: /sql/1.0/warehouses/abcdef1234567890
DATABRICKS_HTTP_PATH=


# Thrift transport and SSL
DATABRICKS_THRIFT_TRANSPORT=http
DATABRICKS_SSL=1

# JDBC driver seetings
DATABRICKS_JDBC_DRIVER_CLASS=com.simba.spark.jdbc.Driver

# Absolute path to the Databricks JDBC jar on your HPC host
# Exmaple: ~/jdbc/databricks-jdbc.jar
DATABRICKS_JDBC_JAR=

# JDBC URL parts
DATABRICKS_JDBC_SCHEME=jdbc:spark
DATABRCISK_JDBC_PORT=443
DATABRICKS_JDBC_DATABASE=default

# JDBC driver options (proxy/arrow toggles; add only if needed)
# DATABRICKS_USER_PROXY=0
# DATABRICKS_PROXY_HOST=proxy.jh.edu
# DATABRICKS_PROXY_PORT=3129

# Some environments disable Arrow for stability behind proxies
DATABRICKS_ENABLE_ARROW=0



# Proxy settings (Optional, only if required by your HPC)
# HTTPS_PROXY=http://proxy.jh.edu:3129
# HTTP_PROXY=
# NO_PROXY=localhost,127.0.0.1


# --- Catalogs and Schemas ---
# Data catalog containing research data
DATABRICKS_DATA_CATALOG=deid

# User scratch catalog
DATABRICKS_USER_CATALOG=reach_users

# Your username / personal database name within reach_users
# Example: mxiong5
DATABRICKS_USERNAME=

# --- HuggingFace Hub ---
# Required for gated models (e.g., Llama 3.1 8B).
# Generate at: https://huggingface.co/settings/tokens
# Accept model license at: https://huggingface.co/meta-llama/Llama-3.1-8B-Instruct
HUGGINGFACE_TOKEN=
